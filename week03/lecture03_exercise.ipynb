   "source": [
    "# Lecture 3 — Class Exercise\n",
    "## Line Charts: CO2 Emissions\n",
    "\n",
    "> **Push to:** `week03/lecture03_exercise.ipynb` in your GitHub repo\n",
    "\n",
    "### Remember:\n",
    "- No spaghetti — if you show multiple lines, grey everything and highlight one\n",
    "- Remove chart borders, heavy gridlines, rotating text\n",
    "- Label directly; avoid legends where possible\n",
    "- Insight title\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load-data",
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "import plotly.graph_objects as go\n",
    "from IPython.display import Image, display\n",
    "\n",
    "# Dataset: CO2 Emissions by Country 2000-2022\n",
    "# Source: Our World in Data (https://ourworldindata.org/co2-emissions)\n",
    "df = pd.read_csv('../data/co2_emissions.csv')\n",
    "print(f'Loaded: {len(df)} rows | Countries: {df[\'Country\'].nunique()} | Years: {df[\'Year\'].min()}-{df[\'Year\'].max()}')\n",
    "print(df.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "save-png",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install the PNG export dependency once in the notebook environment\n",
    "!pip install -q kaleido\n",
    "\n",
    "target_country = 'Germany'\n",
    "output_dir = Path('figures')\n",
    "output_dir.mkdir(exist_ok=True)\n",
    "\n",
    "highlighted = df[df['Country'] == target_country].sort_values('Year').copy()\n",
    "if highlighted.empty:\n",
    "    raise ValueError(f'{target_country} is not present in the dataset.')\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "# Grey background context for all countries\n",
    "for country, group in df.groupby('Country'):\n",
    "    if country == target_country:\n",
    "        continue\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=group['Year'],\n",
    "        y=group['CO2_per_capita'],\n",
    "        mode='lines',\n",
    "        line=dict(color='#EEEEEE', width=1),\n",
    "        hovertemplate=f'{country}<br>Year: %{{x}}<br>CO2 per capita: %{{y:.2f}}<extra></extra>',\n",
    "        showlegend=False\n",
    "    ))\n",
    "\n",
    "# Highlighted country in colour\n",
    "fig.add_trace(go.Scatter(\n",
    "    x=highlighted['Year'],\n",
    "    y=highlighted['CO2_per_capita'],\n",
    "    mode='lines+markers',\n",
    "    line=dict(color='#D62728', width=3),\n",
    "    marker=dict(size=5),\n",
    "    hovertemplate=f'{target_country}<br>Year: %{{x}}<br>CO2 per capita: %{{y:.2f}}<extra></extra>',\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "last_x = highlighted['Year'].iloc[-1]\n",
    "last_y = highlighted['CO2_per_capita'].iloc[-1]\n",
    "fig.add_annotation(\n",
    "    x=last_x,\n",
    "    y=last_y,\n",
    "    text=target_country,\n",
    "    showarrow=False,\n",
    "    xshift=8,\n",
    "    font=dict(color='#D62728', size=12)\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    title=dict(\n",
    "        text=\"Germany's CO2 per-capita emissions have declined since 2000\",\n",
    "        x=0.02,\n",
    "        xanchor='left'\n",
    "    ),\n",
    "    xaxis_title='Year',\n",
    "    yaxis_title='CO2 per capita (dataset units)',\n",
    "    template='plotly_white',\n",
    "    plot_bgcolor='white',\n",
    "    paper_bgcolor='white',\n",
    "    showlegend=False,\n",
    "    margin=dict(l=60, r=100, t=85, b=55),\n",
    ")\n",
    "\n",
    "fig.update_xaxes(showgrid=False, showline=False, zeroline=False)\n",
    "fig.update_yaxes(showgrid=True, gridcolor='#EEEEEE', showline=False, zeroline=False)\n",
    "\n",
    "png_path = output_dir / 'co2_per_capita_germany.png'\n",
    "fig.write_image(str(png_path), scale=2)\n",
    "print(f'Saved PNG: {png_path.resolve()}')\n",
    "display(Image(str(png_path)))\n",
    "fig.show()\n"
   ]
  }
 ],
